# Copy to .env.local for local overrides. Vite inlines VITE_* values at build time,
# so never put a secret here.

# Base path of the REST API. The dev server proxies /api to VITE_DEV_API_TARGET.
VITE_API_BASE_URL=/api/v1

# Socket.IO origin for the support console. Leave empty to use the page's own origin
# (the dev server and nginx both proxy /socket.io to the backend).
VITE_SOCKET_URL=

# Dev server only: where /api and /socket.io are proxied to.
VITE_DEV_API_TARGET=http://localhost:5000
